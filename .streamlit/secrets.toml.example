# Streamlit Cloud Secrets — copia este contenido en:
# Settings > Secrets de tu app en share.streamlit.io
#
# IMPORTANTE: No subas este archivo con valores reales a GitHub.
# Elige UNO de los siguientes bloques según el proveedor que quieras usar.

# ── Opción A: Amazon Bedrock (Claude 3) ────────────────────────
AWS_ACCESS_KEY_ID = "tu_access_key_aqui"
AWS_SECRET_ACCESS_KEY = "tu_secret_key_aqui"
AWS_DEFAULT_REGION = "us-east-1"
BEDROCK_MODEL_ID = "anthropic.claude-3-haiku-20240307-v1:0"

# ── Opción B: NVIDIA NIM (DeepSeek-V4-Pro) ─────────────────────
# Obtén tu key gratis en https://build.nvidia.com
# NVIDIA_API_KEY = "nvapi-..."
# NVIDIA_MODEL_ID = "deepseek-ai/deepseek-v4-pro"

# ── Opción C: OpenAI / API compatible ──────────────────────────
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL_NAME = "gpt-4o-mini"
