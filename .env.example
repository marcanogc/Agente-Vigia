# ============================================================
# Agente Vigía - Variables de Entorno
# Copia este archivo como .env y rellena los valores
# ============================================================

# --- Amazon Bedrock (Opción recomendada - Free Tier disponible) ---
# Región de AWS donde tienes acceso a Bedrock
AWS_DEFAULT_REGION=us-east-1

# Credenciales de AWS (usa un usuario IAM con permisos AmazonBedrockFullAccess)
# O configura con: aws configure
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Modelo a usar en Bedrock (Claude 3 Haiku es el más económico)
# Opciones: anthropic.claude-3-haiku-20240307-v1:0
#           anthropic.claude-3-sonnet-20240229-v1:0
#           anthropic.claude-instant-v1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- NVIDIA NIM API (Alta capacidad analítica - Free Tier con 1000 req/mes) ---
# Obtén tu API Key gratuita en: https://build.nvidia.com
# Prioridad: se usa si Bedrock no está configurado
# NVIDIA_API_KEY=nvapi-...
#
# Modelo recomendado para análisis de datos complejos:
# deepseek-ai/deepseek-v4-pro  → 1.6T params MoE, 1M ctx, alta precisión analítica
# deepseek-ai/deepseek-v4-flash → 284B MoE, más rápido y eficiente
# Otros modelos disponibles en: https://build.nvidia.com
# NVIDIA_MODEL_ID=deepseek-ai/deepseek-v4-pro

# --- OpenAI Compatible API (Alternativa / Fallback) ---
# Descomenta si quieres usar OpenAI u otro proveedor compatible
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL_NAME=gpt-4o-mini

# --- Configuración General ---
# Fecha de referencia para auditorías (ISO 8601). Dejar vacío para usar la fecha actual.
# VIGIA_REFERENCE_DATE=2026-07-20T00:00:00
